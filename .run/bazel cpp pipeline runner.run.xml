<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="bazel cpp pipeline runner" type="BlazeCommandRunConfigurationType" factoryName="Bazel Command">
    <blaze-settings handler-id="BlazeCommandGenericRunConfigurationHandlerProvider" blaze-command="run" kind="cc_binary">
      <blaze-target>//mediapipe/examples/desktop/hand_tracking:hand_tracking_pipeline_run</blaze-target>
      <blaze-user-flag>-c</blaze-user-flag>
      <blaze-user-flag>opt</blaze-user-flag>
      <blaze-user-flag>--define</blaze-user-flag>
      <blaze-user-flag>MEDIAPIPE_DISABLE_GPU=1</blaze-user-flag>
      <blaze-user-flag>--define</blaze-user-flag>
      <blaze-user-flag>OPENCV=source</blaze-user-flag>
      <blaze-user-flag>--disk_cache=$USER_HOME$/.cache/bazel-disk-cache</blaze-user-flag>
      <blaze-user-flag>--fission=no</blaze-user-flag>
      <blaze-user-exe-flag>--graph_file=mediapipe/modules/hand_landmark/hand_landmark_tracking_cpu.pbtxt</blaze-user-exe-flag>
      <blaze-user-exe-flag>--input_video_path=sample-video.avi</blaze-user-exe-flag>
      <blaze-user-exe-flag>--reference_data_path=output_dat_v0.10.13.pb</blaze-user-exe-flag>
      <blaze-user-exe-flag>--output_video_path=output_video.mp4</blaze-user-exe-flag>
      <env_state>
        <envs>
          <env name="PROJECT_ROOT_DIR" value="$PROJECT_DIR$/.." />
        </envs>
      </env_state>
    </blaze-settings>
    <method v="2">
      <option name="Blaze.BeforeRunTask" enabled="true" />
      <option name="RunConfigurationTask" enabled="true" run_configuration_name="build all hands pipeline main targets" run_configuration_type="BlazeCommandRunConfigurationType" />
    </method>
  </configuration>
</component>