<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="build only opencv from source (dbg)" type="BlazeCommandRunConfigurationType" factoryName="Bazel Command">
    <blaze-settings handler-id="BlazeCommandGenericRunConfigurationHandlerProvider" blaze-command="build" kind="cc_library">
      <blaze-target>//third_party:opencv</blaze-target>
      <blaze-user-flag>-c</blaze-user-flag>
      <blaze-user-flag>dbg</blaze-user-flag>
      <blaze-user-flag>--define</blaze-user-flag>
      <blaze-user-flag>OPENCV=source</blaze-user-flag>
      <env_state>
        <envs />
      </env_state>
    </blaze-settings>
    <method v="2">
      <option name="Blaze.BeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>