<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="run our own hands pipeline through Bazel" type="BlazeCommandRunConfigurationType" factoryName="Bazel Command">
    <blaze-settings handler-id="BlazeCLionRunConfigurationHandlerProvider" blaze-command="run" kind="cc_binary">
      <blaze-target>//mediapipe/nui/desktop/hand_tracking:hand_tracking_tflite</blaze-target>
      <blaze-user-flag>--run_under=&quot;cd $BUILD_WORKSPACE_DIRECTORY &amp;&amp;&quot;</blaze-user-flag>
      <blaze-user-flag>-c</blaze-user-flag>
      <blaze-user-flag>opt</blaze-user-flag>
      <blaze-user-flag>--copt=-I/usr/include/opencv4</blaze-user-flag>
      <blaze-user-flag>--define</blaze-user-flag>
      <blaze-user-flag>MEDIAPIPE_DISABLE_GPU=1</blaze-user-flag>
      <blaze-user-exe-flag>bazel-bin/mediapipe/nui/desktop/hand_tracking/hand_tracking_tflite</blaze-user-exe-flag>
      <blaze-user-exe-flag>--calculator_graph_config_file=mediapipe/nui/desktop/hand_tracking_desktop.pbtxt</blaze-user-exe-flag>
      <blaze-user-exe-flag>--input_side_packets=input_video_path=sample-video.avi,output_video_path=output_video.mp4</blaze-user-exe-flag>
      <env_state>
        <envs />
      </env_state>
    </blaze-settings>
    <method v="2">
      <option name="Blaze.BeforeRunTask" enabled="true" />
    </method>
  </configuration>
</component>