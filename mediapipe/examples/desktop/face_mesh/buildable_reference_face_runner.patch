+// limitations under the License.
+
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "absl/flags/flag.h"
+#include "absl/flags/parse.h"
+#include "mediapipe/examples/desktop/face_parity/face_tracking_output.pb.h"
+#include "mediapipe/framework/calculator_framework.h"
+#include "mediapipe/framework/formats/image_frame.h"
+#include "mediapipe/framework/formats/image_frame_opencv.h"
+#include "mediapipe/framework/port/opencv_imgproc_inc.h"
+#include "mediapipe/framework/port/opencv_video_inc.h"
+#include "mediapipe/framework/port/parse_text_proto.h"
+#include "mediapipe/framework/port/ret_check.h"
+#include "mediapipe/framework/port/status_macros.h"
+
+#include <google/protobuf/util/delimited_message_util.h>
+
+ABSL_FLAG(std::string, input_video_path, "", "Input video.");
+ABSL_FLAG(std::string, output_data_path, "", "Delimited output protobuf.");
+ABSL_FLAG(std::uint32_t, max_num_faces, 1,
+          "Maximum number of faces to detect and track.");
+ABSL_FLAG(bool, refine_landmarks, true,
+          "Use the 478-landmark attention model.");
+ABSL_FLAG(bool, static_image_mode, false,
+          "Disable reuse of landmark-derived regions between frames.");
+
+namespace mediapipe {
+namespace {
+
+absl::Status Run() {
+  RET_CHECK_GT(absl::GetFlag(FLAGS_max_num_faces), 0);
+  const CalculatorGraphConfig config =
+      ParseTextProtoOrDie<CalculatorGraphConfig>(R"pb(
+        input_stream: "input_video"
+        input_side_packet: "num_faces"
+        input_side_packet: "with_attention"
+        input_side_packet: "use_previous_landmarks"
+        output_stream: "multi_face_landmarks"
+        node {
+          calculator: "FaceLandmarkFrontCpu"
+          input_stream: "IMAGE:input_video"
+          input_side_packet: "NUM_FACES:num_faces"
+          input_side_packet: "WITH_ATTENTION:with_attention"
+          input_side_packet: "USE_PREV_LANDMARKS:use_previous_landmarks"
+          output_stream: "LANDMARKS:multi_face_landmarks"
+        }
+      )pb");
+
+  CalculatorGraph graph;
+  MP_RETURN_IF_ERROR(graph.Initialize(config));
+  MP_ASSIGN_OR_RETURN(
+      OutputStreamPoller landmark_poller,
+      graph.AddOutputStreamPoller("multi_face_landmarks"));
+  MP_RETURN_IF_ERROR(graph.StartRun({
+      {"num_faces",
+       MakePacket<int>(
+           static_cast<int>(absl::GetFlag(FLAGS_max_num_faces)))},
+      {"with_attention",
+       MakePacket<bool>(absl::GetFlag(FLAGS_refine_landmarks))},
+      {"use_previous_landmarks",
+       MakePacket<bool>(!absl::GetFlag(FLAGS_static_image_mode))},
+  }));
+
+  cv::VideoCapture capture(absl::GetFlag(FLAGS_input_video_path));
+  RET_CHECK(capture.isOpened());
+  std::ofstream output(
+      absl::GetFlag(FLAGS_output_data_path),
+      std::ios::binary | std::ios::trunc);
+  RET_CHECK(output.is_open());
+
+  int frame_number = 0;
+  while (true) {
+    cv::Mat bgr;
+    capture >> bgr;
+    if (bgr.empty()) {
+      break;
+    }
+    cv::Mat rgb;
+    cv::cvtColor(bgr, rgb, cv::COLOR_BGR2RGB);
+
+    auto frame = std::make_unique<ImageFrame>(
+        ImageFormat::SRGB, rgb.cols, rgb.rows,
+        ImageFrame::kDefaultAlignmentBoundary);
+    rgb.copyTo(formats::MatView(frame.get()));
+    MP_RETURN_IF_ERROR(graph.AddPacketToInputStream(
+        "input_video",
+        Adopt(frame.release()).At(Timestamp(frame_number))));
+    MP_RETURN_IF_ERROR(graph.WaitUntilIdle());
+    RET_CHECK_LE(landmark_poller.QueueSize(), 1);
+
+    FaceTrackingOutputData frame_output;
+    frame_output.set_frame_number(frame_number);
+    if (landmark_poller.QueueSize() == 1) {
+      Packet packet;
+      RET_CHECK(landmark_poller.Next(&packet));
+      for (const auto& landmarks :
+           packet.Get<std::vector<NormalizedLandmarkList>>()) {
+        *frame_output.add_multi_face_landmarks() = landmarks;
+      }
+    }
+    RET_CHECK(google::protobuf::util::SerializeDelimitedToOstream(
+        frame_output, &output));
+    ++frame_number;
+  }
+
+  MP_RETURN_IF_ERROR(graph.CloseInputStream("input_video"));
+  MP_RETURN_IF_ERROR(graph.WaitUntilDone());
+  output.close();
+  RET_CHECK(output.good());
+  return absl::OkStatus();
+}
+
+}  // namespace
+}  // namespace mediapipe
+
+int main(int argc, char** argv) {
+  absl::ParseCommandLine(argc, argv);
+  const absl::Status status = mediapipe::Run();
+  return status.ok() ? EXIT_SUCCESS : EXIT_FAILURE;
+}
