# liberation project specific ignores
output_data*

# Bazel / build ignores
# note that some bazel files (and even yarn.lock) we do want tracked in git so they are not defined here to ignore.
# note that third_party/ is a directory where project dependencies are vendored to the build by the original mediapipe
# project and it should remain part of the git view of the repo.
bazel-*
build/
BUILD.backup
mediapipe/MediaPipe.xcodeproj
mediapipe/MediaPipe.tulsiproj/*.tulsiconf-user
mediapipe/provisioning_profile.mobileprovision
mediapipe.egg-info
node_modules/
.configure.bazelrc
.user.bazelrc

# Clion ignores
.clwb/

# Python ignores
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.pytest_cache/
.tox/
.nox/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store

# PyCharm ignores
.idea/
*.iml
*.iws
.idea/**

# Ignore analysis output directory
mediapipe_analysis/analysis/output/

# Developer-specific video files
/sample-video*.avi
/output_video.mp4

# Rust ignores (specific to rust/ folder)
rust/target/
rust/*.rs.bk
rust/*.dSYM/
rust/coverage/
rust/.cargo/
rust/.rustup/
rust/.env
rust/.vscode/
rust/.idea/
rust/.DS_Store
# Uncomment the next line if you do NOT want to track Cargo.lock
rust/Cargo.lock
