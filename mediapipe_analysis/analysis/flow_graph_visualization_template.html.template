<!DOCTYPE html>
<html lang='en'>
<head>
  <meta charset='utf-8'>
  <title>Streams Graph</title>
  <script src='https://d3js.org/d3.v7.min.js'></script>
  <style>
    html, body {{ height: 100%; margin: 0; padding: 0; overflow: hidden; background: #000; }}
    svg {{ width: 100vw; height: 100vh; display: block; background: #000; }}
    .link {{ fill: none; stroke: #0f0; stroke-opacity: 1; stroke-width: 8px; stroke-linecap: round; stroke-linejoin: round; shape-rendering: geometricPrecision; }}
    .arrowhead {{ fill: #0f0; }}
    .arrowhead-shape {{ pointer-events: none; shape-rendering: geometricPrecision; }}
    .node text {{ pointer-events: none; fill: #fff; font-weight: bold; }}
    #nodeSearchBox {{ position: absolute; top: 20px; left: 50%; transform: translateX(-50%); z-index: 10; font-size: 5em; padding: 40px 80px; border-radius: 40px; border: 6px solid #1976d2; background: #222; color: #fff; width: 1600px; text-align: center; }}
    #nodeSearchBox.searchbox-translucent {{ background: rgba(34, 34, 34, 0.25); border-color: rgba(25, 118, 210, 0.25); color: rgba(30, 30, 30, 0.75); }}
    /* Dull the placeholder text when translucent (cross-browser) */
    #nodeSearchBox.searchbox-translucent::placeholder {{ color: rgba(30, 30, 30, 0.55); opacity: 1; }}
    #nodeSearchBox.searchbox-translucent::-webkit-input-placeholder {{ color: rgba(30, 30, 30, 0.55); opacity: 1; }}
    #nodeSearchBox.searchbox-translucent::-moz-placeholder {{ color: rgba(30, 30, 30, 0.55); opacity: 1; }}
    #nodeSearchBox.searchbox-translucent:-ms-input-placeholder {{ color: rgba(30, 30, 30, 0.55); opacity: 1; }}
    #nodeSearchBox.searchbox-translucent::-ms-input-placeholder {{ color: rgba(30, 30, 30, 0.55); opacity: 1; }}
    #copyFeedbackBox {{ position: fixed; top: 250px; left: 50%; transform: translateX(-50%); background: #4CAF50; color: #fff; padding: 30px 60px; border-radius: 25px; font-size: 2.5em; z-index: 100; display: none; font-weight: bold; transition: opacity 0.3s ease; text-align: center; min-width: 600px; }}
    #HelpBox {{ position: fixed; bottom: 20px; right: 20px; background: rgba(31, 114, 36, 0.76); color: rgba(0, 0, 0, 0.93); padding: 15px; border-radius: 10px; font-size: 1.5em; z-index: 100; }}
    #hoverBox {{ position: fixed; top: 0; left: 0; display: none; z-index: 200; color: #fff; background: rgba(68, 68, 68, 0.92); border: 3px solid #444; border-radius: 12px; padding: 16px 18px; max-width: 40vw; box-shadow: 0 8px 24px rgba(0,0,0,0.4); pointer-events: none; }}
    #hoverBox .hb-title {{ font-weight: 900; font-size: 1.6em; line-height: 1.1; margin-bottom: 8px; }}
    #hoverBox .hb-desc {{ font-weight: 400; font-size: 1.1em; line-height: 1.3; white-space: normal; word-wrap: break-word; }}
  </style>
</head>
<!--

This template uses double curly braces instead of single curly braces in its CSS and JS as a workaround to prevent Python's `.format()`
from interpreting single braces as template variables. Placeholders like `{nodes_json}` are acknowledged by our python as template variables.
When python is generating the html file from the current html template source file, it fills values for the template variables and reduces
the double curly braces to single ones.

this is all done by python's .format method, which enables this kind of templating as a non-library one-liner.

normally using a proper templating engine (like Jinja2) would avoid this twisting.

-->
<body>
<input autocomplete="off" id="nodeSearchBox" placeholder="paste or type a node name to focus it ..." type="text" />
<div id="copyFeedbackBox"></div>
<div id="HelpBox">
 <button id="closeHelpBox" style="float:right; margin-left:10px; background:rgba(38,77,42,0.76); color:rgba(0,0,0,0.93); border:none; border-radius:5px; font-size:2.5em; cursor:pointer;">✕</button>
 <strong>hover</strong> to focus a node's immediate clique | <strong>click</strong> to make the focus stick <br>
  or <strong>type</strong> or <strong>paste</strong> a node's name in the text box to sticky focus it<br>
  press <strong>ESC</strong> or clear the text box to clear the sticky focus
  <br><br>
  use the <strong>back & forward mouse buttons</strong> to traverse the history of focused nodes
  <br><br>
  keep <strong>shift</strong> held and <strong>hover</strong> a node to see its description
  <br><br>
  <strong>right-click</strong> a node to copy its name to clipboard<br>
  <strong>ctrl + right-click</strong> a node to copy its source code path (if available)
  <br><br>
  press <strong>d</strong> to initiate a new browser tab of the same visualization<br>
  press <strong>+/-</strong> to nudge edge lengths globally (to be improved/deprecated)
</div>
<div id="hoverBox"><div class="hb-title"></div><div class="hb-desc"></div></div>
<svg></svg>
<script>
const nodes = {nodes_json};
const links = {links_json};
const fontScale = {font_scale};
const alphaDecay = {alpha_decay};
const repulsion = -Math.max(window.innerWidth, window.innerHeight) * {repulsion_factor};
const CURVINESS_FACTOR = {curviness_factor};
const CURVINESS_MAX_PX = {curviness_max_px};
let curvyEdgesEnabled = true;

// Visual constants
// Global edge thickness scale (applies to both straight and curved edges)
const EDGE_WIDTH_SCALE = 0.60; // 60% of previous thickness

// Custom arrowhead geometry (used in curvy mode)
// Fixed size so arrowheads are consistent regardless of hover/focus width changes
const ARROW_LEN_PX = 26; // tip-to-base-center length in pixels (before protrusion)
// Triangle base width in pixels
const ARROW_WID_PX = 20;
// Fraction of arrow length by which the tip protrudes into the target node circle
const ARROW_PROTRUSION_FRAC = 0.25; // 25%

const BASE_LINK_DISTANCE = 200;
let userDistanceMultiplier = 1.0;
let currentHoverNode = null;
let stickyFocusNode = null;  // NEW: Track sticky focused node
let shiftHeld = false;
let ctrlHeld = false; // NEW: track Ctrl state uniformly with Shift

// --- Simulation auto-stop configuration ---
const SIM_STOP_AFTER_SECONDS = 4.5; // Stop the force simulation after this many seconds from each (re)start
let simStopTimer = null;          // Timer handle for the scheduled stop
let simRunId = 0;                 // Monotonically increasing token to distinguish runs; increments on every (re)start.
// We count simulation starts (via simRunId) so that any previously scheduled timers from an older run
// cannot stop a newer run. In scheduleSimulationStop() we capture the current runId and only stop the
// simulation if the timer's runId still matches simRunId, effectively cancelling stale timers.
let simulationStopped = false;    // Whether the current run has been stopped
let simFirstClickHandler = null;  // One-shot click listener to stop the simulation on first user click per run

function stopSimulation() {{
  if (!simulation) return;
  try {{ simulation.stop(); }} catch (e) {{}}
  simulationStopped = true;
  if (simStopTimer) {{ clearTimeout(simStopTimer); simStopTimer = null; }}
  // Remove per-run first-click listener if it exists
  try {{
    if (simFirstClickHandler) {{
      window.removeEventListener('click', simFirstClickHandler, true);
      simFirstClickHandler = null;
    }}
  }} catch (e) {{}}
  setCurvyEdgesEnabled(true);
}}

function scheduleSimulationStop() {{
  if (simStopTimer) {{ clearTimeout(simStopTimer); simStopTimer = null; }}
  const runId = simRunId;
  const ms = SIM_STOP_AFTER_SECONDS * 1000;
  simStopTimer = setTimeout(() => {{
    // Only stop if this timer belongs to the current run and it wasn't already stopped
    if (runId === simRunId && simulation && !simulationStopped) {{
      stopSimulation();
    }}
  }}, ms);
}}

function markSimulationStarted() {{
  simulationStopped = false;
  simRunId += 1; // new run token
  setCurvyEdgesEnabled(false);
  scheduleSimulationStop();

  // Arm a per-run first-click stop: on the first user click after start/restart, stop the simulation
  // Remove any previous listener just in case
  try {{
    if (simFirstClickHandler) {{
      window.removeEventListener('click', simFirstClickHandler, true);
      simFirstClickHandler = null;
    }}
  }} catch (e) {{}}

  const runIdAtArm = simRunId;
  simFirstClickHandler = function firstClickStopper(ev) {{
    // Only act for the current run and if not already stopped
    if (runIdAtArm === simRunId && simulation && !simulationStopped) {{
      stopSimulation();
    }}
    // Remove self to ensure one-shot behavior
    try {{
      window.removeEventListener('click', simFirstClickHandler, true);
    }} catch (e) {{}}
    simFirstClickHandler = null;
  }};
  // Use capture to catch clicks even if inner handlers stop propagation
  window.addEventListener('click', simFirstClickHandler, true);
}}

function installSimulationAutoStopHooks() {{
  if (!simulation) return;
  // Simulation (re)start triggers — analyzed and documented:
  //
  // We monkey‑patch d3's simulation.restart() so that ANY time the simulation warms up again
  // we treat it as the start of a NEW run (re‑arming auto‑stop and related UI state). Concretely, in this file the
  // simulation can start or restart due to the following situations:
  //
  // 1) Initial page load / page refresh / opening in a new tab:
  //    - renderGraph() is called at the end of the script, which constructs a new simulation and then calls
  //      installSimulationAutoStopHooks(); markSimulationStarted();
  //    - This is effectively a brand‑new run.
  //
  // 2) Window resize (including maximizing/restoring the window):
  //    - window.addEventListener('resize', ...) calls renderGraph(); which creates a new simulation instance and then
  //      calls markSimulationStarted(); (it also bumps alpha to 1 on the fresh instance).
  //    - So resizing leads to a new run.
  //
  // 3) User begins a drag on a node:
  //    - In dragstarted(), when !event.active we call simulation.alphaTarget(0.3).restart();
  //    - That explicit restart is captured by our monkey‑patch and treated as a new run.
  //
  // 4) Programmatic centering/animation of a focused node:
  //    - In animateNodeToViewport(), we call simulation.alpha(0.3).restart(); during the animation loop.
  //    - Each such restart is treated as a new run; the auto‑stop timer is re‑armed accordingly.
  //    - Selecting a node via the search box can trigger this path when the node is off‑screen:
  //      search input → focusNode(found) → animateNodeToViewport(found) → simulation.alpha(...).restart().
  //
  // 5) Any other explicit calls to simulation.restart() (present or future):
  //    - Our patch wraps simulation.restart, so any direct or library‑internal .restart() calls are treated as
  //      new runs automatically.
  //
  // Notes on what does NOT constitute a restart here:
  //    - Calls that only bump alpha without .restart() (e.g., refreshVisibility() uses simulation.alpha(...)) are not
  //      restarts by themselves; they keep the current run.
  //    - Key presses '+'/'-' adjust forces and bump alpha, but do not call .restart(); still the run continues.
  //
  // Implementation detail:
  // We must also avoid patching multiple times (e.g., on window resize re‑render), so we set a guard flag below.
  if (!simulation.__autoStopPatched) {{
    const origRestart = simulation.restart;
    simulation.restart = function() {{
      // Call the original restart, then mark the run as (re)started so the timer is re-scheduled.
      const res = origRestart.apply(this, arguments);
      markSimulationStarted();
      return res;
    }};
    // Mark as patched so we don't wrap again.
    simulation.__autoStopPatched = true;
  }}
}}
// --- End Simulation auto-stop configuration ---

let hoverBoxNode = null; // id of node currently showing hover box
let hoverBoxEl = null; // cached element reference
let hoverGroupEl = null; // the SVG group element for hovered node
let draggingNode = null; // currently dragged node datum (or null)
let hoverEnabled = false; // Block hover-induced actions until the user moves the mouse at least once

function setSearchBoxToNode(node) {{
  const searchBox = document.getElementById('nodeSearchBox');
  searchBox.value = node && node.id ? node.id : '';
}}

function copyToClipboard(text, label) {{
  function showCopyFeedback(msg) {{
    const feedbackDiv = document.getElementById('copyFeedbackBox');
    feedbackDiv.textContent = msg;
    feedbackDiv.style.display = 'block';
    feedbackDiv.style.opacity = '1';
    setTimeout(() => {{
      feedbackDiv.style.opacity = '0';
      setTimeout(() => {{ feedbackDiv.style.display = 'none'; }}, 300);
    }}, 1200);
  }}

  if (navigator.clipboard && window.isSecureContext) {{
    navigator.clipboard.writeText(text)
      .then(() => showCopyFeedback('✓ ' + label + ' copied to clipboard'))
      .catch(() => fallbackCopy(text, label));
  }} else {{
    fallbackCopy(text, label);
  }}

  function fallbackCopy(text, label) {{
    try {{
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.left = '-9999px';
      textarea.style.top = '-9999px';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const successful = document.execCommand('copy');
      document.body.removeChild(textarea);
      if (successful) {{
        showCopyFeedback('✓ ' + label + ' copied to clipboard');
      }} else {{
        showCopyFeedback('✗ Copy failed');
      }}
    }} catch (err) {{
      console.error('Copy failed:', err);
      showCopyFeedback('✗ Copy failed');
    }}
  }}
}}

function getSize() {{
  return [window.innerWidth, window.innerHeight];
}}

// Helper function to get node ID from D3.js object or string
function getNodeId(nodeRef) {{
  return (typeof nodeRef === 'object' && nodeRef.id) ? nodeRef.id : nodeRef;
}}

// --- Node index and adjacency helpers ---
let idToNode = new Map(); // id -> node datum
let neighborsById = new Map(); // id -> Set of neighbor ids (undirected)

function rebuildNodeIndexes() {{
  idToNode = new Map();
  neighborsById = new Map();
  try {{
    nodes.forEach(n => idToNode.set(n.id, n));
    links.forEach(l => {{
      const s = getNodeId(l.source);
      const t = getNodeId(l.target);
      if (!neighborsById.has(s)) neighborsById.set(s, new Set());
      if (!neighborsById.has(t)) neighborsById.set(t, new Set());
      neighborsById.get(s).add(t);
      neighborsById.get(t).add(s);
    }});
  }} catch (e) {{ /* best-effort build */ }}
}}

rebuildNodeIndexes();

// Parameterizable intersection threshold (fraction of node bbox area that must overlap the search box)
let SEARCH_BOX_INTERSECT_MIN_FRAC = 0.05;
window.setSearchBoxIntersectionThreshold = function(frac) {{
  const f = +frac;
  if (!isFinite(f)) return;
  SEARCH_BOX_INTERSECT_MIN_FRAC = Math.max(0, Math.min(1, f));
}};

function getSearchBoxRect() {{
  const el = document.getElementById('nodeSearchBox');
  if (!el) return null;
  try {{ return el.getBoundingClientRect(); }} catch(e) {{ return null; }}
}}

function nodeOverlapFracWithSearchBox(node, searchRect) {{
  if (!node || !searchRect) return 0;
  // Approximate circle by its bounding box for overlap calculation
  const r = (typeof nodeRadius === 'number' && isFinite(nodeRadius)) ? nodeRadius : 30;
  const ax = node.x - r, ay = node.y - r, aw = 2 * r, ah = 2 * r;
  const bx = searchRect.left, by = searchRect.top, bw = searchRect.width, bh = searchRect.height;
  const ax2 = ax + aw, ay2 = ay + ah;
  const bx2 = bx + bw, by2 = by + bh;
  const ix = Math.max(0, Math.min(ax2, bx2) - Math.max(ax, bx));
  const iy = Math.max(0, Math.min(ay2, by2) - Math.max(ay, by));
  const overlapArea = ix * iy;
  const areaA = aw * ah;
  if (areaA <= 0) return 0;
  return overlapArea / areaA;
}}

function nodeIntersectsSearchBox(node, minFrac) {{
  const rect = getSearchBoxRect();
  if (!rect) return false;
  const frac = nodeOverlapFracWithSearchBox(node, rect);
  return frac >= (typeof minFrac === 'number' ? minFrac : SEARCH_BOX_INTERSECT_MIN_FRAC);
}}

function setSearchBoxTranslucentMode(enabled) {{
  const el = document.getElementById('nodeSearchBox');
  if (!el) return;
  if (enabled) {{
    if (!el.classList.contains('searchbox-translucent')) el.classList.add('searchbox-translucent');
  }} else {{
    if (el.classList.contains('searchbox-translucent')) el.classList.remove('searchbox-translucent');
  }}
}}

function refreshSearchBoxMode() {{
  // Manual override: when user interacts with the search box, keep default visuals
  if (window.__searchBoxManualOverride__) {{ setSearchBoxTranslucentMode(false); return; }}

  // Consider the actively interacted node: prefer a dragging node, else the hovered node (hover only if enabled)
  const activeNode = draggingNode || (hoverEnabled ? currentHoverNode : null);

  // Enable translucent mode when:
  // 1) The active node intersects the search box; OR
  // 2) Any node in the active node's clique has a neighbor that intersects the search box.
  if (!activeNode) {{ setSearchBoxTranslucentMode(false); return; }}

  const minFrac = SEARCH_BOX_INTERSECT_MIN_FRAC;
  // Condition 1
  if (nodeIntersectsSearchBox(activeNode, minFrac)) {{
    setSearchBoxTranslucentMode(true);
    return;
  }}

  // Condition 2
  try {{
    const clique = getNodeClique(activeNode.id);
    for (const cid of clique) {{
      const neigh = neighborsById.get(cid);
      if (!neigh || neigh.size === 0) continue;
      for (const nid of neigh) {{
        const n = idToNode.get(nid);
        if (n && nodeIntersectsSearchBox(n, minFrac)) {{
          setSearchBoxTranslucentMode(true);
          return;
        }}
      }}
    }}
  }} catch(e) {{ /* ignore and treat as no match */ }}

  // Otherwise, revert
  setSearchBoxTranslucentMode(false);
}}

function getStableLinkDistance(link) {{
  const baseDistance = BASE_LINK_DISTANCE * userDistanceMultiplier;
  const minimumDistance = 80;

  if (currentHoverNode) {{
    const sourceId = getNodeId(link.source);
    const targetId = getNodeId(link.target);
    if (sourceId === currentHoverNode.id || targetId === currentHoverNode.id) {{
      return Math.max(baseDistance * 0.5, minimumDistance);
    }}
  }}

  return Math.max(baseDistance, minimumDistance);
}}

// --- Hover box helpers ---
let lastMouseX = 0, lastMouseY = 0;
function ensureHoverBox() {{
  if (!hoverBoxEl) hoverBoxEl = document.getElementById('hoverBox');
  return hoverBoxEl;
}}
function getNodeFill(n) {{ return n.url ? '#1976d2' : '#333'; }}
function parseColorToRgb(color) {{
  if (!color) return null;
  // If already rgba or rgb
  if (color.startsWith('rgb')) {{
    const nums = color.match(/\d+\.?\d*/g);
    if (!nums || nums.length < 3) return null;
    return {{ r: +nums[0], g: +nums[1], b: +nums[2] }};
  }}
  // Hex formats: #rgb, #rgba, #rrggbb, #rrggbbaa
  if (color[0] === '#') {{
    let h = color.slice(1);
    if (h.length === 3) {{ h = h.split('').map(c => c + c).join(''); }}
    if (h.length === 4) {{ h = h.split('').map(c => c + c).join(''); }} // ignore alpha
    if (h.length >= 6) {{
      const bigint = parseInt(h.slice(0,6), 16);
      const r = (bigint >> 16) & 255;
      const g = (bigint >> 8) & 255;
      const b = bigint & 255;
      return {{ r, g, b }};
    }}
  }}
  return null;
}}
function colorToRgba(color, alpha) {{
  const rgb = parseColorToRgb(color);
  if (!rgb) return `rgba(25, 118, 210, ${{alpha}})`; // fallback to blue
  const {{ r, g, b }} = rgb;
  return `rgba(${{r}}, ${{g}}, ${{b}}, ${{alpha}})`;
}}
function setHoverBoxContent(d) {{
  const el = ensureHoverBox();
  const title = el.querySelector('.hb-title');
  const desc = el.querySelector('.hb-desc');
  title.textContent = d.id || '';
  const text = (d.description && String(d.description).trim().length) ? d.description : '(no description)';
  desc.textContent = text;
}}
function styleHoverBoxForNode(d) {{
  const el = ensureHoverBox();
  // Prefer the actual circle's current fill; fallback to url-based color
  let fill = null;
  try {{
    if (hoverGroupEl) {{
      const sel = d3.select(hoverGroupEl).select('circle');
      const styleFill = sel.style('fill');
      const attrFill = sel.attr('fill');
      fill = (styleFill && styleFill !== 'none') ? styleFill : attrFill;
    }}
  }} catch (e) {{}}
  if (!fill) fill = getNodeFill(d);

  el.style.borderColor = fill || '#1976d2';

  // If the node is gray (#333 or rgb(51, 51, 51)), use a slightly lighter gray background; else match node color
  const isGray = (fill && (fill.trim().toLowerCase() === '#333' || fill.replace(/\s+/g,'') === 'rgb(51,51,51)'));
  const bgColor = isGray ? '#444' : (fill || '#1976d2');
  el.style.background = colorToRgba(bgColor, 0.92);
  el.style.color = '#fff';
}}
function clampPosition(x, y) {{
  const el = ensureHoverBox();
  el.style.left = '-1000px'; // move away to measure
  el.style.top = '-1000px';
  el.style.display = 'block';
  const rect = el.getBoundingClientRect();
  const margin = 12;
  let nx = Math.max(margin, Math.min(x, window.innerWidth - rect.width - margin));
  let ny = Math.max(margin, Math.min(y, window.innerHeight - rect.height - margin));
  return {{ x: nx, y: ny }};
}}
function positionHoverBox(x, y) {{
  const offset = 18;
  const p = clampPosition(x + offset, y + offset);
  const el = ensureHoverBox();
  el.style.left = p.x + 'px';
  el.style.top = p.y + 'px';
}}
function getNodeScreenCenter(groupEl) {{
  try {{
    const c = groupEl.querySelector('circle');
    if (!c) return null;
    const r = c.getBoundingClientRect();
    return {{ x: r.left + r.width / 2, y: r.top + r.height / 2 }};
  }} catch(e) {{ return null; }}
}}
function hideNodeLabelByGroup(groupEl) {{
  try {{ d3.select(groupEl).select('text').style('display', 'none').style('opacity', '0'); }} catch (e) {{}}
}}
function restoreNodeLabelByGroup(groupEl) {{
  try {{ d3.select(groupEl).select('text').style('display', null).style('opacity', null); }} catch (e) {{}}
}}
function restoreNodeLabelById(nodeId) {{
  try {{ if (!node || !nodeId) return; node.filter(n => n.id === nodeId).select('text').style('display', null).style('opacity', null); }} catch (e) {{}}
}}
function showHoverBoxForNode(d, groupEl, x, y) {{
  hoverBoxNode = d.id;
  hoverGroupEl = groupEl;
  setHoverBoxContent(d);
  styleHoverBoxForNode(d);
  const el = ensureHoverBox();
  el.style.display = 'block';
  positionHoverBox(x ?? lastMouseX, y ?? lastMouseY);
}}
function hideHoverBox() {{
  const el = ensureHoverBox();
  el.style.display = 'none';
  if (hoverGroupEl) {{
    restoreNodeLabelByGroup(hoverGroupEl);
  }} else if (hoverBoxNode) {{
    restoreNodeLabelById(hoverBoxNode);
  }}
  hoverBoxNode = null;
  hoverGroupEl = null;
}}
// --- end hover box helpers ---

// Centralized hover box state refresher: shows when (hovered && Shift) else hides
function refreshHoverBox() {{
  // Block all hover-box behavior until the user has moved the mouse at least once
  if (!hoverEnabled) {{ hideHoverBox(); return; }}

  // Lazily resolve the hovered group's element if missing (e.g., Shift pressed after hover)
  if (shiftHeld && currentHoverNode && !hoverGroupEl && node) {{
    try {{
      node.each(function(n) {{ if (!hoverGroupEl && n.id === currentHoverNode.id) hoverGroupEl = this; }});
    }} catch (e) {{}}
  }}

  if (shiftHeld && currentHoverNode && hoverGroupEl) {{
    if (draggingNode && currentHoverNode.id === draggingNode.id) {{
      const center = getNodeScreenCenter(hoverGroupEl);
      if (center) {{
        showHoverBoxForNode(currentHoverNode, hoverGroupEl, center.x, center.y);
      }} else {{
        showHoverBoxForNode(currentHoverNode, hoverGroupEl, lastMouseX, lastMouseY);
      }}
    }} else {{
      showHoverBoxForNode(currentHoverNode, hoverGroupEl, lastMouseX, lastMouseY);
    }}
  }} else {{
    hideHoverBox();
  }}
}}

let simulation, node, link, arrow, nodeRadius;

// NEW: Move updateLinkDisplay to global scope as well
function updateLinkDisplay() {{
  if (!link) return; // Guard against being called before initialization

  link.each(function(d) {{
    const line = d3.select(this);

    // Calculate link length and adjust endpoints
    const dx = d.target.x - d.source.x;
    const dy = d.target.y - d.source.y;
    const length = Math.sqrt(dx * dx + dy * dy) || 1;

    const padding = curvyEdgesEnabled ? 0 : 2;
    const sourceRadius = nodeRadius + padding;
    const targetRadius = nodeRadius + padding;
    const ux = dx / length;
    const uy = dy / length;

    const startX = d.source.x + ux * sourceRadius;
    const startY = d.source.y + uy * sourceRadius;
    const endX = d.target.x - ux * targetRadius;
    const endY = d.target.y - uy * targetRadius;

    // Build path command: straight when animating, curved when stable/stopped
    let pathD;
    let cx = null, cy = null; // control point for curve when curvy
    if (curvyEdgesEnabled) {{
      const mx = (startX + endX) / 2;
      const my = (startY + endY) / 2;
      const offset = Math.min(CURVINESS_FACTOR * length, CURVINESS_MAX_PX);
      const perpX = -uy;
      const perpY = ux;
      cx = mx + perpX * offset;
      cy = my + perpY * offset;
      pathD = 'M ' + startX + ',' + startY + ' Q ' + cx + ',' + cy + ' ' + endX + ',' + endY;
    }} else {{
      pathD = 'M ' + startX + ',' + startY + ' L ' + endX + ',' + endY;
    }}

    line.attr('d', pathD);

    // Determine color and marker per existing logic
    let strokeColor = '#0f0';
    let markerId = 'arrowhead-green';
    const roots = getRoots();
    if (roots && roots.length) {{
      const blueIncomingIds = new Set(roots.map(r => r.id));
      const rootIdSet = blueIncomingIds; // same nodes are considered roots for outgoing edges
      const sourceId = getNodeId(d.source);
      const targetId = getNodeId(d.target);

      const isBlueIncoming = blueIncomingIds.has(targetId);
      const isGreenOutgoing = rootIdSet.has(sourceId);

      if (isBlueIncoming) {{
        strokeColor = '#1976d2';
        markerId = 'arrowhead-blue';
      }} else if (isGreenOutgoing) {{
        strokeColor = '#0f0';
        markerId = 'arrowhead-green';
      }} else {{
        strokeColor = '#0f0';
        markerId = 'arrowhead-green';
      }}
    }} else {{
      strokeColor = '#0f0';
      markerId = 'arrowhead-green';
    }}

    line.style('stroke', strokeColor, 'important');

    // Arrowheads handling:
    // - Straight edges: keep built-in markers
    // - Curvy edges: remove markers, draw custom triangle so the tip touches target circle
    if (curvyEdgesEnabled) {{
      line.attr('marker-end', null);
      const arrowEl = d.__arrowEl;
      if (arrowEl) {{
        const segDx = endX - startX;
        const segDy = endY - startY;
        const segLen = Math.sqrt(segDx * segDx + segDy * segDy) || 1;

        // Tangent at end of quadratic bezier is end - control; fallback to straight segment
        let tx = (cx !== null && cy !== null) ? (endX - cx) : segDx;
        let ty = (cx !== null && cy !== null) ? (endY - cy) : segDy;
        const tlen = Math.sqrt(tx * tx + ty * ty) || 1;
        const tux = tx / tlen;
        const tuy = ty / tlen;

        // Fixed-size arrowhead for consistency; clamp by segment length for very short links
        let arrowLen = Math.min(ARROW_LEN_PX, segLen * 0.6);
        let arrowWid = ARROW_WID_PX;

        // Make the tip protrude slightly into the target node by a fraction of its length
        const protrude = ARROW_PROTRUSION_FRAC * arrowLen; // inline-documented ratio

        const apexX = endX + tux * protrude;
        const apexY = endY + tuy * protrude;
        const baseCenterX = apexX - tux * arrowLen;
        const baseCenterY = apexY - tuy * arrowLen;
        const px = -tuy; // perp unit
        const py = tux;
        const halfW = arrowWid / 2;
        const b1x = baseCenterX + px * halfW;
        const b1y = baseCenterY + py * halfW;
        const b2x = baseCenterX - px * halfW;
        const b2y = baseCenterY - py * halfW;

        const ad = 'M ' + apexX + ',' + apexY + ' L ' + b1x + ',' + b1y + ' L ' + b2x + ',' + b2y + ' Z';
        arrowEl.setAttribute('d', ad);
        arrowEl.setAttribute('fill', strokeColor);
      }}
    }} else {{
      line.attr('marker-end', 'url(#' + markerId + ')');
    }}
  }});
}}

function setCurvyEdgesEnabled(enabled) {{
  // Always-curvy mode: ignore requests to disable
  if (!enabled) return;
  if (curvyEdgesEnabled === true) return;
  curvyEdgesEnabled = true;
  if (link) {{
    refreshVisibility();
    updateLinkDisplay();
    setTimeout(refreshVisibility, 10);
    setTimeout(updateLinkDisplay, 10);
  }}
}}

// Helper function to get node clique (connected nodes)
function getNodeClique(nodeId) {{
  const connectedIds = new Set([nodeId]);
  links.forEach(l => {{
      const sourceId = getNodeId(l.source);
      const targetId = getNodeId(l.target);
      if (sourceId === nodeId) connectedIds.add(targetId);
      if (targetId === nodeId) connectedIds.add(sourceId);
    }});
  return connectedIds;
}}

// --- Centralized visibility management ---
function getRoots() {{
  const roots = [];
  if (stickyFocusNode) roots.push(stickyFocusNode);
  if (currentHoverNode && (!stickyFocusNode || currentHoverNode.id !== stickyFocusNode.id)) roots.push(currentHoverNode);
  return roots;
}}

function computeVisibility() {{
  const roots = getRoots();
  let visibleNodeIds;
  if (roots.length === 0) {{
    visibleNodeIds = new Set(nodes.map(n => n.id));
  }} else {{
    visibleNodeIds = new Set();
    roots.forEach(r => {{
      getNodeClique(r.id).forEach(id => visibleNodeIds.add(id));
    }});
  }}

  const rootIdSet = new Set(roots.map(r => r.id));
  const visibleEdgeSet = new Set();
  links.forEach(l => {{
    const s = getNodeId(l.source);
    const t = getNodeId(l.target);
    const bothVisible = visibleNodeIds.has(s) && visibleNodeIds.has(t);
    if (roots.length === 0) {{
      if (bothVisible) visibleEdgeSet.add(l);
    }} else if (ctrlHeld) {{
      if (bothVisible) visibleEdgeSet.add(l);
    }} else {{
      if (bothVisible && (rootIdSet.has(s) || rootIdSet.has(t))) {{
        visibleEdgeSet.add(l);
      }}
    }}
  }});
  // Return as array to avoid template curly brace confusion
  return [visibleNodeIds, visibleEdgeSet, roots.length];
}}

function refreshVisibility() {{
  if (!node || !link) return;
  const res = computeVisibility();
  const visibleNodeIds = res[0];
  const visibleEdgeSet = res[1];
  const rootsCount = res[2];

  node.style('display', n => visibleNodeIds.has(n.id) ? '' : 'none');
  const baseWidth = rootsCount ? 16 : 8;
  const width = baseWidth * EDGE_WIDTH_SCALE; // apply global 60% thickness
  link.style('display', l => visibleEdgeSet.has(l) ? '' : 'none')
      .attr('stroke-width', width);

  // Sync custom arrowhead visibility with links and curvy mode
  if (typeof arrow !== 'undefined' && arrow) {{
    arrow.style('display', d => (visibleEdgeSet.has(d)) ? '' : 'none');
  }}

  // Preserve gray/blue fills
  node.filter(n => visibleNodeIds.has(n.id))
      .select('circle')
      .attr('fill', n => n.url ? '#1976d2' : '#333');

  // Keep focused node border if present
  node.select('circle')
    .attr('stroke', n => stickyFocusNode && n.id === stickyFocusNode.id ? '#fff' : null)
    .attr('stroke-width', n => stickyFocusNode && n.id === stickyFocusNode.id ? 4 : null);

  simulation.force('link').distance(getStableLinkDistance);
  simulation.alpha(Math.min(simulation.alpha() + 0.1, 0.3));
  updateLinkDisplay();
  setTimeout(updateLinkDisplay, 10);
  // Keep search box mode in sync with latest visibility/hover state
  refreshSearchBoxMode();
}}
// --- End centralized visibility ---

function applyStickyFocus(focusNode) {{
  stickyFocusNode = focusNode;
  currentHoverNode = focusNode;

  // Pin focused node where it is for stability
  focusNode.fx = focusNode.x;
  focusNode.fy = focusNode.y;

  simulation.force('link').distance(getStableLinkDistance);
  simulation.alpha(Math.min(simulation.alpha() + 0.3, 0.5));

  // Centralized visibility update
  refreshVisibility();
}}

function clearStickyFocus() {{
  if (!stickyFocusNode) return;

  const prevStickyNode = stickyFocusNode;
  stickyFocusNode = null;
  currentHoverNode = null;

  if (prevStickyNode) {{
    prevStickyNode.fx = null;
    prevStickyNode.fy = null;
  }}

  simulation.force('link').distance(getStableLinkDistance);
  simulation.alpha(Math.min(simulation.alpha() + 0.1, 0.3));

  // Centralized visibility update
  refreshVisibility();
}}

function renderGraph() {{
  const [width, height] = getSize();
  const svg = d3.select('svg').attr('width', width).attr('height', height);
  svg.selectAll('*').remove();

  // FIXED: Smaller, more nuanced arrowheads that match edge colors
  const defs = svg.append('defs');

  // Create arrowheads for both normal (green) and hover (blue) states
  const arrowheadConfigs = [
    {{ id: 'arrowhead-green', color: '#0f0' }},
    {{ id: 'arrowhead-blue', color: '#1976d2' }}
  ];

  arrowheadConfigs.forEach(config => {{
    defs.append('marker')
        .attr('id', config.id)
        .attr('viewBox', '-0 -3 8 6')
        .attr('refX', 32)
        .attr('refY', 0)
        .attr('orient', 'auto')
        .attr('markerWidth', 8)
        .attr('markerHeight', 8)
        .attr('xoverflow', 'visible')
      .append('svg:path')
        .attr('d', 'M0,-3L8,0L0,3')
        .attr('fill', config.color);
  }});

  nodeRadius = Math.max(30, Math.min(width, height) / 18);

  simulation = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(links).id(d => d.id).distance(getStableLinkDistance))
      .force('charge', d3.forceManyBody().strength(repulsion))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(nodeRadius + 5))
      .alpha(1)
      .alphaTarget(0.3)
      .alphaDecay(alphaDecay);

  // Install auto-stop hooks and schedule a stop for this fresh run
  installSimulationAutoStopHooks();
  markSimulationStarted();

  link = svg.append('g')
      .selectAll('path')
      .data(links)
      .enter().append('path')
      .attr('class', 'link');

  // Custom arrowheads for curvy mode (hidden by default; shown when curvy edges enabled)
  arrow = svg.append('g')
      .selectAll('path')
      .data(links)
      .enter().append('path')
      .attr('class', 'arrowhead-shape')
      .style('display', 'none');

  // Keep a direct reference from link datum to its arrow element for faster updates
  try {{ arrow.each(function(d) {{ d.__arrowEl = this; }}); }} catch(e) {{}}

  node = svg.append('g')
      .selectAll('g')
      .data(nodes)
      .enter().append('g')
      .attr('class', 'node')
      .call(d3.drag()
          .filter(event => event.button === 0) // Only allow left mouse button for drag
          .on('start', dragstarted)
          .on('drag', dragged)
          .on('end', dragended))
      .on('mouseover', nodeMouseOver)
      .on('mouseout', nodeMouseOut);

  node.append('circle')
  .attr('r', nodeRadius)
  .attr('fill', d => d.url ? '#1f77b4' : '#333')
  .on('click', function(event, d) {{
    if (event.button === 0) {{
      // Left click: creates sticky focus
      if (stickyFocusNode && stickyFocusNode.id === d.id) {{
        clearStickyFocus();
        setSearchBoxToNode(null);
      }} else {{
        focusNode(d);
      }}
    }}
    }}) // end block on click
  .on('contextmenu', function(event, d) {{ // right click handling is performend (by the contextmenu event) here
    event.preventDefault();
    event.stopPropagation();
    if (event.ctrlKey) {{ // right click and control held: copy source code path
      if (d.url) {{
        const filePath = d.url.replace('file://', '');
        copyToClipboard(filePath, 'node\'s source code path');
      }} else {{
        const feedbackDiv = document.getElementById('copyFeedbackBox');
        feedbackDiv.textContent = 'no source code path available for ' + d.id;
        // Use a neutral gray background for this specific notification
        const prevBg = feedbackDiv.style.background;
        feedbackDiv.style.background = '#9E9E9E'; // gray
        feedbackDiv.style.display = 'block';
        feedbackDiv.style.opacity = '1';
        setTimeout(() => {{
          feedbackDiv.style.opacity = '0';
          setTimeout(() => {{
            feedbackDiv.style.display = 'none';
            // Restore default success color for subsequent messages
            feedbackDiv.style.background = '#4CAF50';
          }}, 300);
        }}, 3000);
      }}
    }}
    else {{ // right click without ctrl held: copy node name
      if (navigator.clipboard && window.isSecureContext) {{
        navigator.clipboard.writeText(d.id);
      }} else {{
        try {{
          const textarea = document.createElement('textarea');
          textarea.value = d.id;
          textarea.style.position = 'fixed';
          textarea.style.left = '-9999px';
          textarea.style.top = '-9999px';
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }} catch (err) {{
          console.error('Copy failed:', err);
        }}
      }}
      copyToClipboard(d.id, 'node name');
    }} // end right click handling
  }}); // end block on contextmenu

  node.append('text')
      .attr('x', 0)
      .attr('y', 0)
      .attr('text-anchor', 'middle')
      .style('dominant-baseline', 'middle')
      .style('font-size', (fontScale * nodeRadius) + 'px')
      .style('font-weight', 'normal')
      .text(d => d.id);


  simulation.on('tick', () => {{
    updateLinkDisplay();

    node.attr('transform', d => `translate(${{d.x}}, ${{d.y}})`);
    // Update search box translucent mode on movement
    refreshSearchBoxMode();
  }});

  // Enable curvy edges when the simulation naturally cools to a stop
  simulation.on('end', () => {{
    simulationStopped = true;
    if (simStopTimer) {{ clearTimeout(simStopTimer); simStopTimer = null; }}
    setCurvyEdgesEnabled(true);
  }});

  function dragstarted(event, d) {{
    if (!event.active) simulation.alphaTarget(0.3).restart();
    d.fx = d.x; d.fy = d.y;
    // Keep hoverbox active during drag when Shift is held
    draggingNode = d;
    hoverGroupEl = this; // the <g> for this node
    currentHoverNode = d;
    if (shiftHeld) {{
      // Use last known mouse position (also updated by node mousemove/global moves)
      showHoverBoxForNode(d, hoverGroupEl, lastMouseX, lastMouseY);
    }}
    refreshSearchBoxMode();
  }}
  function dragged(event, d) {{
    d.fx = event.x; d.fy = event.y;
    // While dragging, if hoverbox conditions are met, keep it visible and follow the node
    if (shiftHeld && currentHoverNode && hoverGroupEl && hoverBoxNode === d.id) {{
      const center = getNodeScreenCenter(hoverGroupEl);
      if (center) {{ positionHoverBox(center.x, center.y); }}
    }}
    refreshSearchBoxMode();
  }}
  function dragended(event, d) {{
    if (!event.active) simulation.alphaTarget(0);
    d.fx = null; d.fy = null;
    // Clear dragging state and reconcile hoverbox visibility
    draggingNode = null;
    refreshHoverBox();
    refreshSearchBoxMode();
  }}

  function nodeMouseOver(event, d) {{
    if (!hoverEnabled) {{ return; }}
    hoverGroupEl = this;
    currentHoverNode = d;
    lastMouseX = event.clientX; lastMouseY = event.clientY;
    refreshHoverBox();
    refreshVisibility();
    refreshSearchBoxMode();
  }}

function nodeMouseOut(event, d) {{
    // If we're actively dragging this node, don't treat it as a real mouseout
    if (draggingNode && draggingNode.id === d.id) {{
      return;
    }}
    currentHoverNode = null;
    hoverGroupEl = null;
    refreshHoverBox();
    refreshVisibility();
    refreshSearchBoxMode();
  }}
  // --- Focused Node History Mechanism ---
  let focusHistory = [];
  let focusHistoryIndex = -1;

  function deduplicateHistory() {{
    // Remove consecutive duplicates
    focusHistory = focusHistory.filter((id, i, arr) => i === 0 || id !== arr[i - 1]);
  }}

  function pushFocusHistory(nodeId) {{
    // Truncate future if not at end
    if (focusHistoryIndex < focusHistory.length - 1) {{
      focusHistory = focusHistory.slice(0, focusHistoryIndex + 1);
    }}
    // Only add if not duplicate
    if (focusHistory[focusHistoryIndex] !== nodeId) {{
      focusHistory.push(nodeId);
      deduplicateHistory();
      focusHistoryIndex = focusHistory.length - 1;
    }}
  }}

  function focusNodeById(nodeId, updateSearchBox = true) {{
    const nodeObj = nodes.find(n => n.id === nodeId);
    if (!nodeObj) return;
    applyStickyFocus(nodeObj);
    if (updateSearchBox) setSearchBoxToNode(nodeObj);
  }}

  function isNodeInViewport(node, margin = 40) {{
    return (
      node.x > margin &&
      node.x < window.innerWidth - margin &&
      node.y > margin &&
      node.y < window.innerHeight - margin
    );
  }}

  function getTargetPosition(node, margin = 40) {{
    let x = node.x, y = node.y;
    if (node.x < margin) x = margin;
    if (node.x > window.innerWidth - margin) x = window.innerWidth - margin;
    if (node.y < margin) y = margin;
    if (node.y > window.innerHeight - margin) y = window.innerHeight - margin;
    return {{ x, y }};
  }}

  function forceNodeIntoView(focusNode, margin = 40, strength = 0.5) {{
    return function(alpha) {{
      if (!focusNode) return;
      if (isNodeInViewport(focusNode, margin)) return;
      const target = getTargetPosition(focusNode, margin);
      focusNode.vx += (target.x - focusNode.x) * strength * alpha;
      focusNode.vy += (target.y - focusNode.y) * strength * alpha;
    }};
  }}

  // Moves a node into viewport center when it's off-screen.
  // Invoked by focusNode(...) after search-box selection if the node is out of view.
  // This function calls simulation.alpha(0.3).restart() while animating, so it restarts the simulation run.
  function animateNodeToViewport(node) {{
    if (isNodeInViewport(node, 80)) return; // Already in view

    const [width, height] = getSize();
    const targetX = width / 2;
    const targetY = height / 2;
    const duration = 800; // ms
    const startX = node.x;
    const startY = node.y;
    const dx = targetX - startX;
    const dy = targetY - startY;

    let startTime = null;

    function animate(timestamp) {{
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const t = Math.min(elapsed / duration, 1);

      // Cubic ease-out: 1 - (1 - t)^3
      const ease = 1 - Math.pow(1 - t, 3);

      // Set fixed position during animation
      node.fx = startX + dx * ease;
      node.fy = startY + dy * ease;

      // Restart simulation to update positions
      simulation.alpha(0.3).restart();

      if (t < 1) {{
        requestAnimationFrame(animate);
          }} else {{
            // Animation complete - keep the node pinned at final position
            node.fx = targetX;
            node.fy = targetY;
            simulation.alphaTarget(0.1);
          }}
    }}

    requestAnimationFrame(animate);
  }}

  function focusNode(node) {{
      applyStickyFocus(node);
      setSearchBoxToNode(node);
      pushFocusHistory(node.id);
      animateNodeToViewport(node);

      // const feedbackDiv = document.getElementById('copyFeedbackBox');
      // feedbackDiv.textContent = 'node focused';
      // feedbackDiv.style.display = 'block';
      // feedbackDiv.style.opacity = '1';
      // setTimeout(() => {{
      //   feedbackDiv.style.opacity = '0';
      //   setTimeout(() => {{ feedbackDiv.style.display = 'none'; }}, 300);
      // }}, 1200);
  }}

  function handleHistoryNavigation(direction) {{
    if (direction === 'back' && focusHistoryIndex > 0) {{
      focusHistoryIndex--;
      focusNodeById(focusHistory[focusHistoryIndex]);
    }} else if (direction === 'forward' && focusHistoryIndex < focusHistory.length - 1) {{
      focusHistoryIndex++;
      focusNodeById(focusHistory[focusHistoryIndex]);
    }}
  }}

  // Listen for mouse back/forward buttons
  window.addEventListener('pointerup', function(event) {{
    if (event.button === 3) {{ // Back
      handleHistoryNavigation('back');
      event.preventDefault();
    }} else if (event.button === 4) {{ // Forward
      handleHistoryNavigation('forward');
      event.preventDefault();
    }}
  }});
  // --- End Focused Node History Mechanism ---

  const searchBox = document.getElementById('nodeSearchBox');
  // Manual override: while interacting with the search box, keep it in default mode
  window.__searchBoxManualOverride__ = false;
  function setSearchBoxManualOverride(on) {{
    window.__searchBoxManualOverride__ = !!on;
    if (on) {{ setSearchBoxTranslucentMode(false); }}
    else {{ refreshSearchBoxMode(); }}
  }}
  searchBox.addEventListener('mousedown', function() {{ setSearchBoxManualOverride(true); }});
  searchBox.addEventListener('focus', function() {{ setSearchBoxManualOverride(true); }});
  searchBox.addEventListener('click', function() {{ setSearchBoxManualOverride(true); }});
  searchBox.addEventListener('blur', function() {{ setSearchBoxManualOverride(false); }});

  searchBox.addEventListener('input', function(e) {{
    const val = searchBox.value.trim();
    if (!val) {{
      // Clear sticky focus when search box is emptied
      clearStickyFocus();
      return;
    }}

    const found = nodes.find(n => n.id === val);
    if (!found) {{
      return;
    }}

    // Check if this is a different node than currently sticky focused
    if (stickyFocusNode && stickyFocusNode.id === found.id) {{
      // Same node already sticky focused, no change needed
      return;
    }}

    // FIXED: Clear any existing sticky focus first to ensure all nodes are visible
    // This is crucial because the target node might currently be hidden
    if (stickyFocusNode) {{
      clearStickyFocus();
    }}

    // FIXED: Small delay to ensure the clear operation completes before applying new focus
    setTimeout(() => {{
      focusNode(found);
    }}, 10);
  }});
}}

window.addEventListener('resize', () => {{
  renderGraph();
  if (simulation) simulation.alpha(1);
  // After layout changes, re-evaluate search box mode
  setTimeout(refreshSearchBoxMode, 0);
}});

document.addEventListener('DOMContentLoaded', function() {{
  var closeBtn = document.getElementById('closeHelpBox');
  var helpBox = document.getElementById('HelpBox');
  if (closeBtn && helpBox) {{
    closeBtn.onclick = function() {{
      helpBox.style.display = 'none';
    }};
  }}
}});

// Track mouse position globally for hover box positioning
window.addEventListener('mousemove', function(e) {{
  lastMouseX = e.clientX;
  lastMouseY = e.clientY;
  if (!hoverEnabled) {{
    hoverEnabled = true; // First real user motion: allow hover features from now on
    // Re-evaluate UI dependent on hover state
    refreshHoverBox();
    refreshVisibility();
    refreshSearchBoxMode();
  }}
  if (hoverBoxNode) {{ positionHoverBox(lastMouseX, lastMouseY); }}
}});

// Unified modifier tracking (Shift, Ctrl) for hoverbox and visibility
function updateModifiersFromEvent(e) {{
  const newShift = !!e.shiftKey;
  const newCtrl = !!e.ctrlKey;
  const changed = (newShift !== shiftHeld) || (newCtrl !== ctrlHeld);
  if (changed) {{
    shiftHeld = newShift;
    ctrlHeld = newCtrl;
    refreshHoverBox();
    refreshVisibility();
    refreshSearchBoxMode();
  }}
}}

document.addEventListener('keydown', updateModifiersFromEvent, true);

document.addEventListener('keyup', updateModifiersFromEvent, true);

window.addEventListener('blur', function() {{
  if (shiftHeld || ctrlHeld) {{
    shiftHeld = false; ctrlHeld = false;
    refreshHoverBox();
    refreshVisibility();
  }}
}});

document.addEventListener('keydown', function(event) {{
  if (!simulation) return;

  // NEW: Handle Escape key to clear focus and search box
  if (event.key === 'Escape') {{
    clearStickyFocus();
    setSearchBoxToNode(null);
    document.getElementById('nodeSearchBox').blur(); // Remove focus from search box
    event.preventDefault();
    return;
  }}

  if (event.key === 'd' || event.key === 'D') {{
    if (event.target.id !== 'nodeSearchBox') {{ // Don't trigger when typing in search box
      window.open(window.location.href, '_blank');
      event.preventDefault();
    }}
    return;
  }}

  // NEW: 's' key stops the force simulation (unless typing in the search box)
  if (event.key === 's' || event.key === 'S') {{
    if (event.target.id !== 'nodeSearchBox') {{
      stopSimulation();
      event.preventDefault();
    }}
    return;
  }}

  if (event.target.id === 'nodeSearchBox') return;

  const adjustmentFactor = 1.2;
  let newMultiplier;

  if (event.key === '+' || event.key === '=') {{
    newMultiplier = userDistanceMultiplier * adjustmentFactor;
    userDistanceMultiplier = newMultiplier;

    simulation.force('link').distance(getStableLinkDistance);
    simulation.alpha(Math.min(simulation.alpha() + 0.1, 0.3));

    const feedbackDiv = document.getElementById('copyFeedbackBox');
    feedbackDiv.style.background = '#FF9800';
    feedbackDiv.textContent = 'edge lengths nudged globally up (' + (userDistanceMultiplier * 100).toFixed(0) + '%)';
    feedbackDiv.style.display = 'block';
    feedbackDiv.style.opacity = '1';
    setTimeout(() => {{
      feedbackDiv.style.opacity = '0';
      setTimeout(() => {{
        feedbackDiv.style.display = 'none';
        feedbackDiv.style.background = '#4CAF50';
      }}, 300);
    }}, 1200);

    event.preventDefault();
  }} else if (event.key === '-') {{
    newMultiplier = Math.max(0.3, userDistanceMultiplier / adjustmentFactor);
    userDistanceMultiplier = newMultiplier;

    simulation.force('link').distance(getStableLinkDistance);
    simulation.alpha(Math.min(simulation.alpha() + 0.1, 0.3));

    const feedbackDiv = document.getElementById('copyFeedbackBox');
    feedbackDiv.style.background = '#FF9800';
    feedbackDiv.textContent = 'edge lengths nudged globally down (' + (userDistanceMultiplier * 100).toFixed(0) + '%)';
    feedbackDiv.style.display = 'block';
    feedbackDiv.style.opacity = '1';
    setTimeout(() => {{
      feedbackDiv.style.opacity = '0';
      setTimeout(() => {{
        feedbackDiv.style.display = 'none';
        feedbackDiv.style.background = '#4CAF50';
      }}, 300);
    }}, 800);

    event.preventDefault();
  }}
}});

renderGraph();
// Initialize visibility based on current state (no focus => show all)
refreshVisibility();
</script>
</body>
</html>
