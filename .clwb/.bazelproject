directories:
  # directories considered as source directories are defined for Clion here, when it's a bazel project.
  # as long as the . entry is included here, we should include - entries as well to in the least avoid the
  # target directories of downstream build systems like pip and cargo from being considered as source directories,
  # which would otherwise cause their cleans (cargo clean, pip uninstall) to invalidate bazel build outputs,
  # and even possibly cause non-determinism in the form of race conditions once a downstream build is generating
  # its files while bazel is invalidating outputs which the downstream build is trying to read.
  # if doint this from scratch, it is easy to only define what to include in .bazelproject,
  # as we do in github.com/nui-ai/mediapipe-current already.
  .
  -rust   # should be ignored by bazel. may avoid bazel or the bazel IDE plugin invalidating build outputs on cargo operations.
  -.venv  # should be ignored by bazel. may possibly avoid bazel or the bazel IDE plugin invalidating build outputs on pip uninstall which was previously observed.
  -.run
  -.idea
  -.clwb
  -.git
  -.github

targets:
  # we use the below to include all targets under the directories defined above rather than listing them individually here,
  # which is a little sloppy but can ensure that everything is being included in bazel info and build commands.
  # if redone, this should be replaced with explicit target listings as in the original file, as many
  # mediapipe build targets issue errors from the bazel plugin's bazel info work on its sync operation,
  # which clutter the bazel plugin log obfuscating the health of the targets which we are actually
  # interested in.

# Automatically includes all relevant targets under the 'directories' above
derive_targets_from_directories: true

additional_languages:
  # Uncomment any additional languages you want supported
  # dart
  # javascript
  # python
  # typescript
  python
